{
  "name": "@fgaudo/effect-tea-persistent",
  "private": true,
  "description": "The Elm architecture for long-lived entities on a server, on Effect v4: a design and its pure core",
  "license": "MIT",
  "author": "Francesco Gaudenzi",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "exports": {
    ".": "./src/index.ts",
    "./program": "./src/index.program.ts",
    "./testing": "./src/index.testing.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:parallel": "bun test --parallel=8",
    "test:release": "SCHEDULES=all bun test",
    "test:spikes": "bun test '--path-ignore-patterns=node_modules/**' ./spikes",
    "test:postgres": "bun test '--path-ignore-patterns=node_modules/**' src/check.test.ts src/storage.test.ts src/postgres.test.ts src/fixtures.property.test.ts src/runtime",
    "links": "bun scripts/check-links.ts"
  },
  "peerDependencies": {
    "@effect/sql-sqlite-node": "4.1.3"
  },
  "peerDependenciesMeta": {
    "@effect/sql-sqlite-node": {
      "optional": true
    }
  },
  "devDependencies": {
    "@effect/platform-bun": "4.1.3",
    "@effect/sql-pg": "4.1.3",
    "@effect/sql-pglite": "4.1.3",
    "@effect/sql-sqlite-bun": "4.1.3",
    "@effect/sql-sqlite-node": "4.1.3",
    "@electric-sql/pglite": "0.5.15",
    "@fgaudo/effect-tea": "0.7.1",
    "@types/bun": "^1.4.3",
    "effect": "4.1.3",
    "fast-check": "^4.10.2",
    "typescript": "^7.0.2"
  }
}
